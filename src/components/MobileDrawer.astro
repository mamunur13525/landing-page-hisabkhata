---
import Button from './ui/Button.astro';

const navLinks = [
  { index: '০১', label: 'ফিচার্স', href: '#features', badge: 'POS & বাকি' },
  { index: '০২', label: 'সফটওয়্যার ট্যুর', href: '#showcase', badge: 'ইন্টারফেস' },
  { index: '০৩', label: 'ব্যবসার ধরন', href: '#solutions', badge: '৬টি সেক্টর' },
  { index: '০৪', label: 'কীভাবে কাজ করে', href: '#how-it-works', badge: '৩ ধাপ' },
  { index: '০৫', label: 'প্রাইসিং প্ল্যান', href: '#pricing', badge: '১৪ দিন ফ্রি' },
  { index: '০৬', label: 'সাধারণ জিজ্ঞাসা', href: '#faq', badge: 'সাপোর্ট' },
];
---

<!-- Mobile Drawer Backdrop -->
<div
  id="mobile-drawer-backdrop"
  class="fixed inset-0 top-0 left-0 w-screen h-screen h-[100dvh] bg-ink/60 z-[60] backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
>
</div>

<!-- Mobile Drawer Sidebar -->
<aside
  id="mobile-drawer"
  class="fixed top-0 right-0 h-screen h-[100dvh] w-[min(340px,88vw)] max-w-sm bg-paper border-l-2 border-line z-[70] flex flex-col justify-between transform translate-x-full transition-transform duration-300 ease-out shadow-[-8px_0_0_0_#171715] overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="মোবাইল নেভিগেশন মেনু"
>
  <div class="p-5 sm:p-6 flex flex-col min-h-full justify-between">
    <!-- Top Row -->
    <div>
      <div class="flex items-center justify-between pb-4 border-b-2 border-line">
        <a href="#" class="font-mono font-bold text-lg tracking-tighter text-ink flex items-center select-none">
          <span>Hisabee</span>
          <span class="text-xs bg-yellow px-1 py-0.5 ml-1 border border-line">OS</span>
          <sup class="text-[#777670] font-sans font-medium text-[10px] ml-1">পিওএস</sup>
        </a>

        <button
          id="close-menu-btn"
          type="button"
          class="w-8 h-8 border border-line bg-white hover:bg-yellow active:bg-ink active:text-white flex items-center justify-center font-mono font-bold text-sm text-ink cursor-pointer transition-all shadow-[2px_2px_0_0_#171715] hover:-translate-y-0.5 active:translate-y-0"
          aria-label="মেনু বন্ধ করুন"
        >
          ✕
        </button>
      </div>

      <!-- Navigation List -->
      <nav class="flex flex-col divide-y divide-soft-line/60 py-4" aria-label="মোবাইল মেনু লিংক">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link group flex items-center justify-between py-3 px-1 text-ink hover:text-ink transition-colors"
            >
              <div class="flex items-center gap-2.5">
                <span class="font-mono text-[11px] text-muted font-bold tracking-wider">
                  [{link.index}]
                </span>
                <span class="font-serif font-bold text-sm sm:text-base group-hover:underline underline-offset-4">
                  {link.label}
                </span>
              </div>
              <span class="font-mono text-[10px] text-muted px-1.5 py-0.5 bg-white border border-soft-line">
                {link.badge}
              </span>
            </a>
          ))
        }
      </nav>
    </div>

    <!-- Bottom Actions -->
    <div class="pt-6 border-t-2 border-line flex flex-col gap-2.5 mt-4">
      <Button
        variant="accent"
        size="md"
        href="https://hisabs-khata.vercel.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center font-bold shadow-[2px_2px_0_0_#171715]"
      >
        <span>হিসাবী অ্যাকাউন্টে লগইন করুন</span>
        <span class="text-ink ml-1 font-bold">↗</span>
      </Button>

      <Button variant="dark" size="md" href="#pricing" class="w-full text-center mobile-nav-link font-bold">
        ১৪ দিনের ফ্রি ট্রায়াল →
      </Button>

      <Button variant="outline" size="md" class="w-full text-center" data-open-demo>
        ভিডিও ডেমো দেখুন ▷
      </Button>

      <div class="text-[11px] font-mono text-center text-muted pt-2 flex items-center justify-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <a href="tel:+8801935015460" class="hover:text-ink hover:underline font-semibold">সরাসরি হেল্পলাইন: 01935-015460</a>
      </div>
    </div>
  </div>
</aside>

<script>
  function setupDrawer() {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!mobileBtn || !drawer || !backdrop) return;

    // Prevent duplicate binding
    if (drawer.dataset.initialized === 'true') return;
    drawer.dataset.initialized = 'true';

    function openDrawer() {
      drawer?.classList.remove('translate-x-full');
      drawer?.classList.add('translate-x-0');

      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100', 'pointer-events-auto');

      mobileBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer?.classList.add('translate-x-full');
      drawer?.classList.remove('translate-x-0');

      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      backdrop?.classList.remove('opacity-100', 'pointer-events-auto');

      mobileBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    mobileBtn.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    navLinks.forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.classList.contains('translate-x-full')) {
        closeDrawer();
      }
    });

    // Handle resize: if resized to desktop (>= 1024px), automatically close drawer
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024 && !drawer.classList.contains('translate-x-full')) {
        closeDrawer();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDrawer);
  } else {
    setupDrawer();
  }
  document.addEventListener('astro:page-load', setupDrawer);
</script>
