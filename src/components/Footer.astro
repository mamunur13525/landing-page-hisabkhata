    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-12 sm:gap-14 pb-14 sm:pb-16 border-b border-soft-line">
      <!-- Brand Column -->
      <div class="lg:col-span-4 space-y-5">
        <a href="#" class="inline-flex items-baseline font-mono font-black text-2xl tracking-tighter text-ink">
          Hisabee<span class="text-xs bg-yellow px-1.5 py-0.5 ml-1 border border-line">OS</span>
          <sup class="text-[10px] font-sans font-bold text-charcoal/70 ml-1">পিওএস</sup>
