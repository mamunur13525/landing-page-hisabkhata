<div class="border-2 border-line bg-white/80 grid grid-cols-1 md:grid-cols-3 overflow-hidden shadow-[4px_4px_0_0_var(--color-line)]">
  <!-- Value Card 1: Fast Billing -->
  <article class="p-7 sm:p-9 md:p-10 flex flex-col items-start gap-3 bg-white/95 hover:bg-white transition-all duration-200">
    <div class="flex items-center justify-between w-full mb-1">
      <span class="font-mono font-semibold text-[11px] uppercase tracking-wider text-muted">
        ০১ // দ্রুত বিলিং
      </span>
      <span class="text-xs bg-emerald-50 text-emerald-800 border border-emerald-300 font-mono px-2 py-0.5 font-bold">
        ৩ সেকেন্ড
      </span>
    </div>
    <strong class="font-serif font-bold text-xl sm:text-2xl text-ink leading-snug">
      কাস্টমারের লম্বা লাইন শেষ
    </strong>
    <p class="text-xs sm:text-sm text-muted leading-relaxed mt-1">
      বারকোড স্ক্যান করলেই বিল প্রস্তুত। ব্লুটুথ বা ইউএসবি প্রিন্টারে এক ক্লিকে মেমো ছাপুন।
    </p>
    <div class="mt-6 pt-4 border-t border-soft-line w-full font-mono text-[11px] text-ink font-semibold flex items-center justify-between">
      <span>ইন্টারনেট না থাকলেও চলে</span>
      <span class="text-emerald-700">✓ অফলাইন মোড</span>
    </div>
  </article>

  <!-- Value Card 2: Due Recovery -->
  <article class="p-7 sm:p-9 md:p-10 flex flex-col items-start gap-3 bg-white/95 hover:bg-white transition-all duration-200 md:border-l border-t md:border-t-0 border-line">
    <div class="flex items-center justify-between w-full mb-1">
      <span class="font-mono font-semibold text-[11px] uppercase tracking-wider text-muted">
        ০২ // ডিজিটাল খাতা
      </span>
      <span class="text-xs bg-yellow text-ink border border-line font-mono px-2 py-0.5 font-bold">
        অটো এসএমএস
      </span>
    </div>
    <strong class="font-serif font-bold text-xl sm:text-2xl text-ink leading-snug">
      বাকি টাকা আটকে থাকবে না
    </strong>
    <p class="text-xs sm:text-sm text-muted leading-relaxed mt-1">
      মুখে টাকা চাওয়ার লজ্জা নেই। নির্দিষ্ট দিনে কাস্টমারের ফোনে সরাসরি বিকাশ পেমেন্ট লিংক চলে যাবে।
    </p>
    <div class="mt-6 pt-4 border-t border-soft-line w-full font-mono text-[11px] text-ink font-semibold flex items-center justify-between">
      <span>বকেয়া আদায়ের হার</span>
      <span class="text-emerald-700 font-bold">৯৪% সফল আদায়</span>
    </div>
  </article>

  <!-- Value Card 3: Mobile Dashboard -->
  <article class="p-7 sm:p-9 md:p-10 flex flex-col items-start gap-3 bg-white/95 hover:bg-white transition-all duration-200 md:border-l border-t md:border-t-0 border-line">
    <div class="flex items-center justify-between w-full mb-1">
      <span class="font-mono font-semibold text-[11px] uppercase tracking-wider text-muted">
        ০৩ // স্মার্টফোন কন্ট্রোল
      </span>
      <span class="text-xs bg-blue-50 text-blue-800 border border-blue-300 font-mono px-2 py-0.5 font-bold">
        ২৪/৭ লাইভ
      </span>
    </div>
    <strong class="font-serif font-bold text-xl sm:text-2xl text-ink leading-snug">
      যেখান থেকেই দেখুন লাভ-ক্ষতি
    </strong>
    <p class="text-xs sm:text-sm text-muted leading-relaxed mt-1">
      দোকানে না থাকলেও ফোনে দেখতে পাবেন আজকের মোট বিক্রি, নগদ ক্যাশ ও কর্মচারীর স্টক হিসাব।
    </p>
    <div class="mt-6 pt-4 border-t border-soft-line w-full font-mono text-[11px] text-ink font-semibold flex items-center justify-between">
      <span>কর্মচারী চুরির ঝুঁকি</span>
      <span class="text-emerald-700 font-bold">০% অপচয়</span>
    </div>
  </article>
</div>
