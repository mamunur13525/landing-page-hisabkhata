---
import Button from './ui/Button.astro';
---

<div
  id="demo-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-ink/80 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div
    class="demo-modal-dialog w-full max-w-2xl bg-paper border-2 border-line shadow-[8px_8px_0_0_var(--ink)] scale-95 transition-transform duration-300 overflow-hidden"
  >
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-6 py-4 bg-white border-b border-line">
      <div class="flex items-center gap-2.5">
        <span class="w-3 h-3 rounded-full bg-red-500"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
        <span id="modal-title" class="font-mono text-xs font-bold uppercase tracking-wider text-ink ml-2">
          HisabeeOS · লাইভ সিস্টেম ওয়াকথ্রু
        </span>
      </div>

      <button
        type="button"
        id="modal-close-btn"
        class="w-7 h-7 border border-line bg-paper hover:bg-yellow flex items-center justify-center font-mono font-bold text-sm text-ink cursor-pointer transition-colors"
        aria-label="বন্ধ করুন"
      >
        ✕
      </button>
    </div>

    <!-- Modal Content -->
    <div class="p-6 md:p-8 space-y-6">
      <!-- Simulated Interactive System Player -->
      <div class="relative bg-ink border border-line text-white p-6 md:p-8 font-mono overflow-hidden">
        <div class="flex items-center justify-between text-xs text-white/60 pb-3 border-b border-white/15 mb-4">
          <span class="text-yellow flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            LIVE DEMO ACTIVE
          </span>
          <span>v2.8.4 CLOUD-LOCAL</span>
        </div>

        <div class="space-y-3 text-xs md:text-sm">
          <p class="text-white/80">
            > ইনিশিয়ালাইজেশন সম্পন্ন... লোকাল স্টোরেজ প্রস্তুত।
          </p>
          <div class="p-3 bg-white/5 border border-white/10 space-y-1.5">
            <div class="flex justify-between text-white/90">
              <span>বারকোড স্ক্যানার:</span>
              <span class="text-emerald-400 font-bold">অনলাইন (USB / Bluetooth)</span>
            </div>
            <div class="flex justify-between text-white/90">
              <span>থার্মাল প্রিন্টার:</span>
              <span class="text-emerald-400 font-bold">কানেক্টেড (80mm Auto-cut)</span>
            </div>
            <div class="flex justify-between text-white/90">
              <span>অফলাইন ডাটাবেজ:</span>
              <span class="text-emerald-400 font-bold">সিঙ্ক্রোনাইজড (SQLite/IndexedDB)</span>
            </div>
          </div>
          <p class="text-yellow text-xs">
            ★ কোনো টেকনিক্যাল জটিলতা ছাড়াই দোকানে মাত্র ৫ মিনিটে চালু করা সম্ভব।
          </p>
        </div>
      </div>

      <!-- Quick Feature Checklist -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono">
        <div class="p-3 border border-line bg-white">
          <div class="font-bold text-ink mb-1">⚡ ১ সেকেন্ডে বিলিং</div>
          <p class="text-charcoal/70">বারকোড স্ক্যানে দ্রুততম ক্যাশ/কার্ড মেমো প্রিন্ট</p>
        </div>
        <div class="p-3 border border-line bg-white">
          <div class="font-bold text-ink mb-1">📱 অটো খাতা এসএমএস</div>
          <p class="text-charcoal/70">এক ক্লিকে বাকি পরিশোধের ডিজিটাল লিঙ্ক প্রেরণ</p>
        </div>
        <div class="p-3 border border-line bg-white">
          <div class="font-bold text-ink mb-1">🏢 মাল্টি-ব্রাঞ্চ লগ</div>
          <p class="text-charcoal/70">স্মার্টফোনে লাইভ স্টক ও প্রফিট রিপোর্ট মনিটরিং</p>
        </div>
      </div>

      <!-- Footer Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <Button variant="accent" size="md" href="#cta" class="flex-1 text-center font-bold" id="modal-start-free">
          ১৪ দিনের ফ্রি ট্রায়াল শুরু করুন →
        </Button>
        <Button variant="outline" size="md" href="tel:+8801800447223" class="text-center font-bold">
          সরাসরি প্রতিনিধির সাথে কথা বলুন
        </Button>
      </div>
    </div>
  </div>
</div>

<script>
  function setupDemoModal() {
    const modal = document.getElementById('demo-modal');
    const closeBtn = document.getElementById('modal-close-btn');
    const startFreeBtn = document.getElementById('modal-start-free');
    if (!modal) return;

    function openModal() {
      modal?.classList.remove('opacity-0', 'pointer-events-none');
      modal?.classList.add('opacity-100', 'pointer-events-auto');
      const dialog = modal?.querySelector('.demo-modal-dialog');
      dialog?.classList.remove('scale-95');
      dialog?.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.classList.add('opacity-0', 'pointer-events-none');
      modal?.classList.remove('opacity-100', 'pointer-events-auto');
      const dialog = modal?.querySelector('.demo-modal-dialog');
      dialog?.classList.add('scale-95');
      dialog?.classList.remove('scale-100');
      document.body.style.overflow = '';
    }

    // Attach to triggers
    document.querySelectorAll('[data-open-demo]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    startFreeBtn?.addEventListener('click', closeModal);

    // Click outside backdrop
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('opacity-0')) {
        closeModal();
      }
    });

    // Custom window event support
    window.addEventListener('open-demo-modal', openModal);
  }

  setupDemoModal();
  document.addEventListener('astro:page-load', setupDemoModal);
</script>
