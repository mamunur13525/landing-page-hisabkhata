---
interface Props {
  tag?: string;
  message?: string;
}

const {
  tag = "নতুন v৩.২",
  message = "পূর্ণ স্বচ্ছ ব্যবসায়িক লেজার — ক্লাউড পিওএস · অটো এসএমএস বাকি আদায় · মাল্টি-ব্রাঞ্চ স্টক সিঙ্ক · কোনো ব্যয়বহুল হার্ডওয়্যার লাগবে না"
} = Astro.props;
---

<div class="bg-paper border-b border-soft-line min-h-[32px] px-4 py-1.5 font-mono text-[11px] tracking-wider text-ink flex items-center justify-center text-center uppercase select-none">
  <div class="flex items-center flex-wrap justify-center gap-1.5">
    <span class="bg-yellow text-ink px-1.5 py-0.5 font-bold border border-line text-[10px] shrink-0">
      {tag}
    </span>
    <span>{message}</span>
  </div>
</div>
