---
import SectionHeading from './ui/SectionHeading.astro';
import Carousel from './ui/Carousel.astro';

const solutions = [
  {
    category: 'রিটেইল গ্রোসারি',
    title: 'সুপারমার্কেট ও মুদি দোকান',
    description: 'ওয়েইং স্কেল ইন্টিগ্রেশন, দ্রুত বারকোড স্ক্যানিং, মাল্টি-প্যাক ডিসকাউন্ট ও কাস্টমার বাকি খাতার দ্রুত হিসাব।',
    tag: 'জনপ্রিয়',
    link: '#pricing'
  },
  {
    category: 'লাইফস্টাইল ও ফ্যাশন',
    title: 'পোশাক, জুতা ও ফ্যাশন বুটিক',
    description: 'সাইজ, কালার ও ফিট ম্যাট্রিক্স ম্যানেজমেন্ট, নিজস্ব বারকোড স্টিকার প্রিন্ট ও সিজনাল সেলস ডিসকাউন্ট কন্ট্রোল।',
    tag: 'মাল্টি-কালার',
    link: '#pricing'
  },
  {
    category: 'ফার্মাসিউটিক্যালস',
    title: 'ফার্মেসি ও ড্রাগ স্টোর',
    description: 'জেনারের নামসহ হাজারো ঔষধের ডাটাবেজ, ব্যাচ ট্র্যাকিং, এক্সপায়ারি অ্যালার্ট এবং চিকিৎসকের প্রেসক্রিপশন সংরক্ষণ।',
    tag: 'লাইফ-সেভিং',
    link: '#pricing'
  },
  {
    category: 'হার্ডওয়্যার ও ডিভাইস',
    title: 'ইলেকট্রনিক্স ও মোবাইল শপ',
    description: 'সিরিয়াল নম্বর ও আইএমইআই (IMEI) ওয়ারেন্টি ট্র্যাকিং, কাস্টমার সার্ভিস জব কার্ড ও যন্ত্রাংশ রিপ্লেসমেন্ট লগ।',
    tag: 'ওয়ারেন্টি',
    link: '#pricing'
  },
  {
    category: 'পাইকারি ও আড়ত',
    title: 'পাইকারি ব্যবসায়ী ও পরিবেশক',
    description: 'বাল্ক ভলিউম হোলসেল রেট, ডিস্ট্রিবিউটর বাকি লেজার, ডেলিভারি চালান ও সেলস রিপ্রেজেন্টেটিভ অর্ডার বুকিং।',
    tag: 'বাল্ক ট্রেড',
    link: '#pricing'
  },
  {
    category: 'খাবার ও পানীয়',
    title: 'রেস্তোরাঁ, ক্যাফে ও বেকারি',
    description: 'টেবিল ম্যানেজমেন্ট, কিচেন অর্ডার টিকিট (KOT) প্রিন্টিং, খাদ্য রেসিপি খরচ এবং অনলাইন ডেলিভারি হিসাব।',
    tag: 'ফাস্ট ফুড',
    link: '#pricing'
  }
];
---

<section id="solutions" class="border-t border-line py-16 md:py-20 bg-white">
  <div class="shell">
    <SectionHeading
      title="আপনার ব্যবসার"
      emphasis="উপযোগী।"
      eyebrow="যেকোনো কাজের ধরন ও যেকোনো সাইজের দোকানের সমাধান"
      description="আপনি পাড়ার মুদি দোকান চালান কিংবা ২০টি শাখা বিশিষ্ট চেইন স্টোর—হিসাবীর প্রতিটি ফিচার সাজানো হয়েছে আপনার দৈনন্দিন প্রয়োজনের কথা মাথায় রেখে।"
      split={true}
    />

    <!-- Solutions Interactive Carousel -->
    <Carousel id="solutions-carousel" autoplay={true} interval={6000}>
      {
        solutions.map((item) => (
          <article class="min-w-[280px] sm:min-w-[340px] md:min-w-[380px] snap-start border border-line bg-paper p-6 sm:p-7 flex flex-col justify-between hover:bg-white hover:-translate-y-1 hover:shadow-[4px_4px_0_var(--color-line)] transition-all duration-200">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-[10px] font-semibold text-muted uppercase tracking-wider">
                  {item.category}
                </span>
                <span class="bg-yellow text-ink border border-line font-mono text-[10px] font-bold px-2 py-0.5">
                  {item.tag}
                </span>
              </div>

              <h3 class="font-serif font-bold text-xl text-ink leading-snug mb-3">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-muted leading-relaxed mb-6">
                {item.description}
              </p>
            </div>

            <a
              href={item.link}
              class="font-mono font-semibold text-xs text-ink hover:underline underline-offset-4 flex items-center gap-1 group mt-auto"
            >
              <span>বিস্তারিত সলিউশন দেখুন</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </article>
        ))
      }
    </Carousel>
  </div>
</section>
