---
interface Props {
  id: string;
  class?: string;
  showControls?: boolean;
  showDots?: boolean;
  autoplay?: boolean;
  interval?: number;
}

const {
  id,
  class: className = '',
  showControls = true,
  showDots = true,
  autoplay = false,
  interval = 5000,
} = Astro.props;
---

<div
  class={`carousel-root relative w-full ${className}`}
  id={id}
  data-autoplay={autoplay ? 'true' : 'false'}
  data-interval={interval}
>
  <!-- Track Viewport -->
  <div
    class="carousel-track flex overflow-x-auto scroll-smooth snap-x snap-mandatory no-scrollbar gap-6 sm:gap-7 py-3"
    tabindex="0"
    role="region"
    aria-label="ক্যারোজেল স্লাইডার"
  >
    <slot />
  </div>

  <!-- Bottom Navigation & Indicators Bar -->
  <div class="flex items-center justify-between gap-4 mt-8 pt-4 border-t border-soft-line">
    <!-- Dot Indicators -->
    {
      showDots && (
        <div class="carousel-dots flex items-center gap-1.5" role="tablist" aria-label="স্লাইড ইন্ডিকেটর">
          <!-- Dots dynamically created or synchronized by script -->
        </div>
      )
    }

    <!-- Arrow Buttons -->
    {
      showControls && (
        <div class="carousel-arrows flex items-center gap-2 ml-auto">
          <button
            type="button"
            class="carousel-prev w-9 h-9 border border-line bg-white hover:bg-yellow text-ink flex items-center justify-center font-mono font-bold text-sm cursor-pointer transition-all hover:-translate-y-0.5 active:translate-y-0"
            aria-label="পূর্ববর্তী স্লাইড"
          >
            ←
          </button>
          <button
            type="button"
            class="carousel-next w-9 h-9 border border-line bg-white hover:bg-yellow text-ink flex items-center justify-center font-mono font-bold text-sm cursor-pointer transition-all hover:-translate-y-0.5 active:translate-y-0"
            aria-label="পরবর্তী স্লাইড"
          >
            →
          </button>
        </div>
      )
    }
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function setupCarousels() {
    const init = () => {
      document.querySelectorAll<HTMLElement>('.carousel-root').forEach((root) => {
        if (root.dataset.carouselInitialized === 'true') return;
        root.dataset.carouselInitialized = 'true';

        const track = root.querySelector('.carousel-track') as HTMLElement | null;
        const prevBtn = root.querySelector('.carousel-prev') as HTMLElement | null;
        const nextBtn = root.querySelector('.carousel-next') as HTMLElement | null;
        const dotsContainer = root.querySelector('.carousel-dots') as HTMLElement | null;

        if (!track) return;

        const items = Array.from(track.children) as HTMLElement[];
        if (items.length === 0) return;

        // Build dots using DocumentFragment to prevent layout thrashing
        const dotButtons: HTMLButtonElement[] = [];
        if (dotsContainer) {
          const fragment = document.createDocumentFragment();
          items.forEach((_, idx) => {
            const dot = document.createElement('button');
            dot.type = 'button';
            dot.className = `w-7 h-2 border border-line transition-colors cursor-pointer ${idx === 0 ? 'bg-ink' : 'bg-transparent hover:bg-soft-line'}`;
            dot.setAttribute('aria-label', `স্লাইড ${idx + 1}`);
            dot.addEventListener('click', () => {
              items[idx]?.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
            });
            dotButtons.push(dot);
            fragment.appendChild(dot);
          });
          dotsContainer.innerHTML = '';
          dotsContainer.appendChild(fragment);
        }

        // Use IntersectionObserver: Zero forced reflows, compositor-driven
        let activeIndex = 0;
        if ('IntersectionObserver' in window && dotButtons.length > 0) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const idx = items.indexOf(entry.target as HTMLElement);
                  if (idx !== -1) {
                    activeIndex = idx;
                    dotButtons.forEach((d, i) => {
                      if (i === idx) {
                        d.classList.add('bg-ink');
                        d.classList.remove('bg-transparent');
                      } else {
                        d.classList.remove('bg-ink');
                        d.classList.add('bg-transparent');
                      }
                    });
                  }
                }
              });
            },
            {
              root: track,
              threshold: 0.6,
            }
          );

          items.forEach((item) => observer.observe(item));
        }

        // Arrow click handlers - navigate by slide element with native smooth scroll
        prevBtn?.addEventListener('click', () => {
          const targetIdx = Math.max(0, activeIndex - 1);
          items[targetIdx]?.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });

        nextBtn?.addEventListener('click', () => {
          const targetIdx = Math.min(items.length - 1, activeIndex + 1);
          items[targetIdx]?.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });

        // Autoplay if enabled
        if (root.getAttribute('data-autoplay') === 'true') {
          const interval = parseInt(root.getAttribute('data-interval') || '6000', 10);
          let timer: number | null = null;

          const startTimer = () => {
            if (timer) clearInterval(timer);
            timer = window.setInterval(() => {
              const nextIdx = (activeIndex + 1) % items.length;
              items[nextIdx]?.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
            }, interval);
          };

          const stopTimer = () => {
            if (timer) {
              clearInterval(timer);
              timer = null;
            }
          };

          startTimer();
          root.addEventListener('mouseenter', stopTimer, { passive: true });
          root.addEventListener('mouseleave', startTimer, { passive: true });
        }
      });
    };

    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(init);
    } else {
      setTimeout(init, 60);
    }
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCarousels);
  } else {
    setupCarousels();
  }
  document.addEventListener('astro:page-load', setupCarousels);
</script>
