---
interface FaqItem {
  id: string;
  num: string;
  question: string;
  answer: string;
  defaultOpen?: boolean;
}

const faqs: FaqItem[] = [
  {
    id: 'faq-1',
    num: '01',
    question: 'দোকানের বিদ্যুৎ বা ইন্টারনেট না থাকলে কি সফটওয়্যার চলবে?',
    answer: 'হ্যাঁ, ১০০% চলবে। হিসাবী অফলাইনে কাজ করে। লোডশেডিং বা ওয়াইফাই না থাকলেও আপনি বারকোড স্ক্যান করতে পারবেন, ক্যাশ মেমো প্রিন্ট করতে পারবেন। নেট আসার সাথে সাথে সব ডাটা স্বয়ংক্রিয়ভাবে ক্লাউডে ব্যাকআপ হয়ে যাবে।',
    defaultOpen: true
  },
  {
    id: 'faq-2',
    num: '02',
    question: 'আগের খাতা বা এক্সেল থেকে পণ্যের তালিকা ও বাকি আনা যাবে?',
    answer: 'অবশ্যই! এক্সেল ফাইল থেকে মাত্র ১ মিনিটে হাজারো পণ্য ও পূর্বের বকেয়া হিসাব আপলোড করতে পারবেন। প্রয়োজনে আমাদের সাপোর্ট টিম সম্পূর্ণ বিনামূল্যে আপনার ডাটা ট্রান্সফার করে দেবে।',
    defaultOpen: false
  },
  {
    id: 'faq-3',
    num: '03',
    question: 'কী কী ডিভাইস ও প্রিন্টারে হিসাবী কাজ করবে?',
    answer: 'আপনার হাতের সাধারণ মোবাইল, ট্যাব, ল্যাপটপ বা পিসি—যেকোনো ডিভাইসে হিসাবী চলে। বাজারে প্রচলিত যেকোনো ব্লুটুথ, ইউএসবি থার্মাল প্রিন্টার (২ ইঞ্চি ও ৩ ইঞ্চি) এবং বারকোড স্ক্যানারে সরাসরি কাজ করে।',
    defaultOpen: false
  },
  {
    id: 'faq-4',
    num: '04',
    question: 'অটো এসএমএস বাকি আদায় কীভাবে কাজ করে?',
    answer: 'গ্রাহক বাকি নিলে তার ফোনে নির্দিষ্ট দিনে মার্জিত এসএমএস চলে যাবে। এসএমএসের ভেতরে বিকাশ বা নগদ পেমেন্ট লিংক থাকবে, যাতে গ্রাহক ঘরে বসেই আপনার পাওনা টাকা পরিশোধ করতে পারেন।',
    defaultOpen: false
  },
  {
    id: 'faq-5',
    num: '05',
    question: 'আমার দোকানের হিসাব ও ডাটা কি গোপন ও নিরাপদ থাকবে?',
    answer: '১০০% নিরাপদ ও সুরক্ষিত। ব্যাংক-গ্রেড এনক্রিপশনের মাধ্যমে আপনার দোকানের হিসাব শুধু আপনি দেখতে পারবেন। নিয়মিত ক্লাউড ব্যাকআপের কারণে ফোন নষ্ট বা চুরি হলেও আপনার এক টাকার হিসাবও হারাবে না।',
    defaultOpen: false
  }
];
---

<section id="faq" class="border-t border-line py-14 md:py-20 bg-white">
  <div class="shell">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Sticky Left Intro Column -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-24">
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="font-mono text-xs font-semibold tracking-wider uppercase text-muted">
              সাপোর্ট ও জিজ্ঞাসা
            </span>
          </div>

          <h2 class="font-serif text-2xl md:text-3xl font-bold text-ink mb-3">
            সাধারণ <em class="italic text-ink">প্রশ্নোত্তর।</em>
          </h2>

          <p class="font-serif text-xs md:text-sm text-muted leading-relaxed mb-6">
            হিসাবী শুরু করার আগে প্রয়োজনীয় প্রশ্নগুলোর পরিষ্কার উত্তর জেনে নিন।
          </p>

          <div class="border border-line bg-paper p-5 space-y-2.5">
            <div class="font-mono text-xs font-bold text-ink uppercase tracking-wide">
              সরাসরি কথা বলতে চান?
            </div>
            <p class="text-xs text-muted">
              আমাদের টিম সকাল ৯টা থেকে রাত ১১টা পর্যন্ত আপনার সহযোগিতায় প্রস্তুত।
            </p>
            <div class="pt-1 flex flex-col gap-1.5 font-mono text-xs">
              <a href="tel:+8801800447223" class="font-bold text-ink hover:text-emerald-700 underline flex items-center gap-1.5">
                📞 +৮৮০ ১৮০০-HISABEE
              </a>
              <a href="mailto:support@hisabee.com" class="text-muted hover:text-ink underline flex items-center gap-1.5">
                ✉️ support@hisabee.com
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Accordion List -->
      <div class="lg:col-span-8 divide-y divide-line border-y border-line" id="faq-accordion-list">
        {
          faqs.map((faq) => (
            <div class={`faq-item transition-colors duration-200 ${faq.defaultOpen ? 'bg-paper/40' : ''}`}>
              <button
                type="button"
                class="faq-trigger w-full py-4 sm:py-5 px-4 md:px-6 flex items-start justify-between gap-4 text-left cursor-pointer transition-colors hover:bg-paper"
                aria-expanded={faq.defaultOpen ? 'true' : 'false'}
                aria-controls={`answer-${faq.id}`}
                id={`btn-${faq.id}`}
              >
                <div class="flex items-baseline gap-3">
                  <span class="font-mono text-xs font-bold text-muted shrink-0 select-none">
                    {faq.num}
                  </span>
                  <span class="font-serif text-base sm:text-lg font-bold text-ink tracking-tight">
                    {faq.question}
                  </span>
                </div>
                <span
                  class="faq-icon font-mono text-base font-bold text-ink shrink-0 w-6 h-6 border border-line bg-white flex items-center justify-center select-none"
                  aria-hidden="true"
                >
                  {faq.defaultOpen ? '−' : '+'}
                </span>
              </button>

              <div
                id={`answer-${faq.id}`}
                role="region"
                aria-labelledby={`btn-${faq.id}`}
                class={`faq-body overflow-hidden transition-all duration-300 ${faq.defaultOpen ? 'max-h-96 opacity-100 pb-5 px-4 md:px-6 pl-10 md:pl-12' : 'max-h-0 opacity-0 px-4 md:px-6 pl-10 md:pl-12'}`}
              >
                <p class="font-serif text-xs sm:text-sm text-ink/80 leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function setupFaqAccordion() {
    const triggers = document.querySelectorAll<HTMLButtonElement>('.faq-trigger');

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest('.faq-item');
        if (!item) return;

        const body = item.querySelector('.faq-body') as HTMLElement | null;
        const icon = item.querySelector('.faq-icon') as HTMLElement | null;
        if (!body || !icon) return;

        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          trigger.setAttribute('aria-expanded', 'false');
          body.classList.remove('max-h-96', 'opacity-100', 'pb-5');
          body.classList.add('max-h-0', 'opacity-0');
          icon.textContent = '+';
          item.classList.remove('bg-paper/40');
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          body.classList.remove('max-h-0', 'opacity-0');
          body.classList.add('max-h-96', 'opacity-100', 'pb-5');
          icon.textContent = '−';
          item.classList.add('bg-paper/40');
        }
      });
    });
  }

  setupFaqAccordion();
  document.addEventListener('astro:page-load', setupFaqAccordion);
</script>
